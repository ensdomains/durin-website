{
  "name": "durin-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "build": "node --run typecheck && node node_modules/vite/bin/vite.js build",
    "preview": "node --run build && node node_modules/wrangler/bin/wrangler.js dev --local",
    "deploy": "node --run build && node node_modules/wrangler/bin/wrangler.js deploy"
  },
  "dependencies": {
    "@ensdomains/ensjs": "^4.1.2",
    "@rainbow-me/rainbowkit": "^2.2.4",
    "@tanstack/react-query": "^5.67.2",
    "clsx": "^2.1.1",
    "evm-providers": "^0.6.0",
    "lucide": "^0.456.0",
    "lucide-react": "^0.456.0",
    "pino-pretty": "^12.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "tailwind-merge": "^3",
    "viem": "^2.47.10",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.5.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.2",
    "vite": "^8.1.4",
    "wrangler": "^4.107.1"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "24.22.1",
    "bun": "1.4.4"
  }
}
